{
  "name": "ccd-voice-automation",
  "version": "1.0.0",
  "description": "CCD (Card & Consignment Delivery) inbound voice bot - Twilio webhook + workflow utility REST service",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/initDb.js",
    "db:schema": "node scripts/initDb.js --no-seed",
    "test:scenarios": "node scripts/runScenarios.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.4.0"
  }
}
