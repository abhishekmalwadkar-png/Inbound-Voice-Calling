# ==============================================================================
# CCD Voice Automation - Environment Configuration Template
# ==============================================================================

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Live Agent Escalation & Fallback Settings
LIVE_AGENT_PHONE_NUMBER=+91xxxxxxxxxx

# Application & Server Settings
APP_ENV=development
APP_HOST=0.0.0.0
PORT=8001
DEBUG=true
BASE_URL=http://localhost:8001

# Voice & Speech Synthesis (Amazon Polly via Twilio)
VOICE_NAME=Polly.Kajal
VOICE_LANGUAGE=en-IN

# Security & Session Settings
SECRET_KEY=replace_with_a_secure_random_string
SESSION_TIMEOUT_SECONDS=600

# Database Credentials & Configuration (PostgreSQL)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ccd_logistics_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ccd_logistics_db

LOG_LEVEL=INFO

# Dashboard Login (HTTP Basic Auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me
